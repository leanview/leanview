<?xml version="1.0" encoding="utf-8"?>
<!-- leanview: "Up next" end screen: a band across the top of the screen (full width, 260 dp = 520 px
     high on a 1080p TV at density 2.0, so it ends at y = 520 px of 1080, below the player's seek bar
     and buttons, which it hides). In its middle: the thumbnail of the next video (320 x 180 dp) with
     the countdown ring on it, and beside it the heading, title, channel and, right under them, the
     two buttons. 2026-11-04 the text column had a weighted spacer that, measured by the player's
     frame, stretched it down the screen and left the buttons at its bottom edge; every size here is
     fixed now. The player's own rows start below the band (PlaybackFragment moves them down if they
     would not), so nothing overlaps. The view holds the real focus while the
     remote is on the buttons (so no related video is drawn highlighted) and hands it back to the
     related row when the remote goes down; its children are never focusable: keys are handled by
     EndScreenView. -->
<com.liskovsoft.smartyoutubetv2.tv.ui.endscreen.EndScreenView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leanview_end_screen"
    android:layout_width="match_parent"
    android:layout_height="@dimen/leanview_end_band_height"
    android:background="@drawable/leanview_end_panel"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="320dp"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/leanview_end_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF202020"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <com.liskovsoft.smartyoutubetv2.tv.ui.endscreen.EndScreenRingView
                android:id="@+id/leanview_end_ring"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/leanview_end_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leanview_end_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leanview_end_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/leanview_end_button_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/leanview_end_button"
                    android:clickable="true"
                    android:focusable="false"
                    android:paddingBottom="8dp"
                    android:paddingEnd="22dp"
                    android:paddingStart="22dp"
                    android:paddingTop="8dp"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/leanview_end_button_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/leanview_end_button"
                    android:clickable="true"
                    android:focusable="false"
                    android:paddingBottom="8dp"
                    android:paddingEnd="22dp"
                    android:paddingStart="22dp"
                    android:paddingTop="8dp"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.liskovsoft.smartyoutubetv2.tv.ui.endscreen.EndScreenView>
