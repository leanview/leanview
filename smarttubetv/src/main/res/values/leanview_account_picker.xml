<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- leanview: the "Who's watching?" window (AccountPickerActivity) -->
    <color name="account_picker_background">#0F0F0F</color>
    <color name="account_picker_avatar_background">#3A3A3A</color>
    <color name="account_picker_glyph">#9E9E9E</color>

    <style name="App.Theme.Leanback.AccountPicker" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/account_picker_background</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
